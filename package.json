    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@nx/workspace": "22.6.5",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.58.2",
    "@schematics/angular": "^21.2.7",
    "@slidev/cli": "^52.14.2",
    "@slidev/theme-default": "^0.25.0",
    "@swc-node/register": "~1.11.1",
