{
  "name": "slides",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/slides",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/slides",
        "command": "npx slidev slides.md --open"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/slides"
      ],
      "options": {
        "cwd": "apps/slides",
        "command": "npx slidev build slides.md --out ../../dist/slides --base /"
      }
    }
  }
}